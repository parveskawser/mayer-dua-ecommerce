@{
    ViewData["Title"] = "Attribute Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link href="~/css/attribute-manager.css" rel="stylesheet" />
}

<div class="fixed-layout-wrapper">
    
    <div class="header-section d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-1 text-dark fw-bold">Attribute Management</h4>
            <p class="text-muted small mb-0">Manage product variants and specifications</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="openAttributeModal(0)">
            <i class="fas fa-plus me-2"></i>New Attribute
        </button>
    </div>

    <div class="glass-card">
        
        <div class="table-wrapper">
            <table class="table products-table mb-0" id="attributesTable">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 40%;">Attribute Name</th>
                        <th style="width: 20%;">Display Order</th>
                        <th style="width: 20%;">Type</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody id="attributesTableBody">
                    </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="attributeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="attrModalTitle">Manage Attribute</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="attributeForm">
                    <input type="hidden" id="attrId" value="0" />
    
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">NAME</label>
                        <input type="text" class="form-control" id="attrName" placeholder="e.g. Color, Size" required />
                    </div>

                    <div class="mb-3" id="divAttrOrder">
                        <label class="form-label text-muted small fw-bold">DISPLAY ORDER</label>
                        <input type="number" class="form-control" id="attrOrder" value="0" />
                    </div>

                    <div class="form-check form-switch p-3 bg-light rounded border">
                        <input class="form-check-input ms-0 me-2" type="checkbox" id="attrVariant">
                        <label class="form-check-label fw-semibold" for="attrVariant">Use for Variants?</label>
                        <div class="text-muted small mt-1">If checked, this can be used to generate variants (e.g. Size S, M, L).</div>
                    </div>
                </form>            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveAttribute()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="valuesModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Manage Values: <span id="currentAttrName" class="text-primary"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
    
                <div class="p-3 bg-light border-bottom d-flex gap-2">
                    <input type="hidden" id="valAttributeId" />
                    <input type="hidden" id="valId" value="0" />
        
                    <input type="text" class="form-control" id="valName" placeholder="New Value (e.g. Red)" />
        
                    <button class="btn btn-dark" onclick="saveValue()">
                        <i class="fas fa-plus"></i> Add
                    </button>
                </div>

                <div class="table-wrapper" style="max-height: 400px;">
                    <table class="table products-table mb-0">
                        <thead class="bg-white">
                        <tr>
                            <th class="ps-4">Value</th>
                            <th>Order</th> 
                            <th class="text-end pe-4">Action</th>
                        </tr>
                        </thead>
                        <tbody id="valuesTableBody">
                        </tbody>
                    </table>
                </div>
            </div>
            </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/attribute-manager.js"></script>
}