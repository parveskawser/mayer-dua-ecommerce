@using MDUA.Facade.Interface
@using MDUA.Web.UI.Services.Interface
@inject ICompanyFacade CompanyFacade
@inject ITenantResolver TenantResolver
@inject ISettingsFacade SettingsFacade

@{
    // 1. Resolve Dynamic Company ID
    int currentCompanyId = TenantResolver.GetCompanyId();

    // 2. Fetch Company Details
    var companyObj = CompanyFacade.Get(currentCompanyId);
    string displayCompanyName = companyObj?.CompanyName ?? "MDUA Store";

    // 3. Fetch Favicon
    string favUrl = ViewBag.FaviconUrl as string;
    if (string.IsNullOrEmpty(favUrl))
    {
        string dbFavicon = SettingsFacade.GetGlobalSetting(currentCompanyId, "FaviconUrl");
        favUrl = !string.IsNullOrEmpty(dbFavicon) ? dbFavicon : "/favicon.ico";
    }

    // 4. Fetch Analytics & Security Keys
    string gaId = SettingsFacade.GetGlobalSetting(currentCompanyId, "GoogleAnalyticsId");
    string fbPixelId = SettingsFacade.GetGlobalSetting(currentCompanyId, "FacebookPixelId");

    // --- ADDED: Fetch ReCaptcha Key ---
    string recaptchaSiteKey = SettingsFacade.GetGlobalSetting(currentCompanyId, "RecaptchaSiteKey");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @displayCompanyName</title>

    <link rel="icon" type="image/x-icon" href="@favUrl" />
    <link rel="shortcut icon" type="image/x-icon" href="@favUrl" />

    @* --- Google Analytics --- *@
    @if (!string.IsNullOrEmpty(gaId))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@gaId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '@gaId');
        </script>
    }

    @* --- Facebook Pixel --- *@
    @if (!string.IsNullOrEmpty(fbPixelId))
    {
        <script>
            !function(f,b,e,v,n,t,s)
            {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
            n.callMethod.apply(n,arguments):n.queue.push(arguments)};
            if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
            n.queue=[];t=b.createElement(e);t.async=!0;
            t.src=v;s=b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t,s)}(window, document,'script',
            'https://connect.facebook.net/en_US/fbevents.js');
            fbq('init', '@fbPixelId');
            fbq('track', 'PageView');
        </script>
        <noscript>
            <img height="1" width="1" style="display:none"
                 src="https://www.facebook.com/tr?id=@fbPixelId&ev=PageView&noscript=1" />
        </noscript>
    }

    @* --- ADDED: Google reCAPTCHA v3 --- *@
    @if (!string.IsNullOrEmpty(recaptchaSiteKey))
    {
        <script src="https://www.google.com/recaptcha/api.js?render=@recaptchaSiteKey"></script>
        <script>
            // Global Helper to get token for any action (Login, Checkout, etc.)
            function getRecaptchaToken(actionName) {
                return new Promise((resolve, reject) => {
                    grecaptcha.ready(function() {
                        grecaptcha.execute('@recaptchaSiteKey', {action: actionName})
                        .then(function(token) {
                            resolve(token);
                        })
                        .catch(function(err) {
                            reject(err);
                        });
                    });
                });
            }
        </script>
    }

    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    @section Styles {
        <link rel="stylesheet" href="~/css/home-layout.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                @if (companyObj != null && !string.IsNullOrEmpty(companyObj.LogoImg))
                {
                    <img src="@companyObj.LogoImg" alt="@displayCompanyName" height="30" class="me-2">
                }
                else
                {
                    <i class="fas fa-store me-2 text-warning"></i>
                }
                @displayCompanyName
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="publicNav">
                <form asp-controller="Home" asp-action="Shop" method="get" class="d-flex mx-auto my-2 my-lg-0 search-container" style="width: 100%; max-width: 500px;">
                    <div class="input-group">
                        <input class="form-control" type="search" name="query"
                               placeholder="Search for products..."
                               aria-label="Search"
                               value="@Context.Request.Query["query"]">

                        <button class="btn btn-search" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>

                <ul class="navbar-nav ms-auto align-items-center gap-3">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="LogIn">
                            <i class="fas fa-user-circle me-1 fa-lg"></i> Login
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link position-relative" asp-controller="Cart" asp-action="Index">
                            <i class="fas fa-shopping-cart fa-lg"></i>

                            <span id="cart-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                  style="font-size: 0.7rem; padding: 0.35em 0.65em;">
                                @(Context.Session.GetInt32("CartCount") ?? 0)
                                <span class="visually-hidden">items in cart</span>
                            </span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <partial name="_Footer" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>