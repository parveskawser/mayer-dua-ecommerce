﻿@using MDUA.Facade.Interface
@inject ICompanyFacade CompanyFacade

@{
    // 1. Determine Company Name based on URL or Default to ID 1
    string routeCompany = ViewContext.RouteData.Values["companyName"]?.ToString();
    string displayCompanyName = "MDUA Store"; // Fallback

    // You likely need a method in Facade like GetByName(string name)
    // For now, we assume if no route, we load Company ID 1 (The Host)
    var companyObj = CompanyFacade.Get(1);

    if (companyObj != null)
    {
        displayCompanyName = companyObj.CompanyName;
    }

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @displayCompanyName</title>
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    @section Styles {
        <link rel="stylesheet" href="~/css/home-layout.css" asp-append-version="true" />

    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-store me-2 text-warning"></i>@displayCompanyName
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="publicNav">
                <form asp-controller="Home" asp-action="Shop" method="get" class="d-flex mx-auto my-2 my-lg-0 search-container" style="width: 100%; max-width: 500px;">
                    <div class="input-group">
                        <input class="form-control" type="search" name="query"
                               placeholder="Search for products (e.g. Mobile, Book)..."
                               aria-label="Search"
                               value="@Context.Request.Query["query"]">

                        <button class="btn btn-search" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>

                <ul class="navbar-nav ms-auto align-items-center gap-3">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="LogIn">
                            <i class="fas fa-user-circle me-1 fa-lg"></i> Login
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link position-relative" asp-controller="Cart" asp-action="Index">
                            <i class="fas fa-shopping-cart fa-lg"></i>

                            <span id="cart-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                  style="font-size: 0.7rem; padding: 0.35em 0.65em;">
                                @* Read initial count from Session or default to 0 *@
                                @(Context.Session.GetInt32("CartCount") ?? 0)
                                <span class="visually-hidden">items in cart</span>
                            </span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <partial name="_Footer" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>