@using MDUA.Facade.Interface
@inject ICompanyFacade CompanyFacade
@inject ISettingsFacade SettingsFacade

@{
    // 1. Determine Company ID (Default to 1, or fetch from user claim if available)
    int companyId = 1;
    if (User.Identity.IsAuthenticated)
    {
        var claim = User.FindFirst("CompanyId");
        if (claim != null && int.TryParse(claim.Value, out int id))
        {
            companyId = id;
        }
    }

    // 2. Fetch Data from Database
    var company = CompanyFacade.Get(companyId);
    var footerDesc = SettingsFacade.GetGlobalSetting(companyId, "Footer_Description");

    // 3. Set Fallback Defaults (in case DB is empty) to match your original hardcoded text
    string appName = company?.CompanyName ?? "MDUA Store";
    // Changed: removed the : "Default Text" part
    string address = company?.Address;
    string email = company?.Email;
    string phone = company?.Phone;
    string desc = !string.IsNullOrEmpty(footerDesc) ? footerDesc : "Your one-stop shop for the best quality products. We ensure authentic items, fast delivery, and excellent customer support.";
}

<footer class="bg-dark text-white mt-5 pt-5 pb-3">
    <div class="container">
        <div class="row g-4">

            <div class="col-lg-4 col-md-6">
                <h5 class="fw-bold text-warning mb-3">@appName</h5>
                <p class="small text-secondary">
                    @desc
                </p>
                <div class="mt-3">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-map-marker-alt text-warning me-2"></i>
                        <span class="small">@address</span>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-envelope text-warning me-2"></i>
                        <span class="small">@email</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="fas fa-phone-alt text-warning me-2"></i>
                        <span class="small">@phone</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-2 col-md-6">
                <h6 class="fw-bold mb-3">Quick Links</h6>
                <ul class="list-unstyled small">
                    <li class="mb-2"><a href="/" class="text-decoration-none text-secondary footer-link">Home</a></li>
                    <li class="mb-2"><a href="/all-products" class="text-decoration-none text-secondary footer-link">Shop</a></li>
                    <li class="mb-2"><a href="/about" class="text-decoration-none text-secondary footer-link">About Us</a></li>
                    <li class="mb-2"><a href="/contact" class="text-decoration-none text-secondary footer-link">Contact Us</a></li>
                </ul>
            </div>

            <div class="col-lg-2 col-md-6">
                <h6 class="fw-bold mb-3">Customer Care</h6>
                <ul class="list-unstyled small">
                    <li class="mb-2"><a href="/account" class="text-decoration-none text-secondary footer-link">My Account</a></li>
                    <li class="mb-2"><a href="/cart" class="text-decoration-none text-secondary footer-link">Shopping Cart</a></li>
                    <li class="mb-2"><a href="/terms" class="text-decoration-none text-secondary footer-link">Terms & Conditions</a></li>
                    <li class="mb-2"><a href="/privacy" class="text-decoration-none text-secondary footer-link">Privacy Policy</a></li>
                </ul>
            </div>

            <div class="col-lg-4 col-md-6">
                <h6 class="fw-bold mb-3">Stay Connected</h6>
                <p class="small text-secondary">Subscribe to our newsletter for latest updates and offers.</p>
                <form class="mb-3" onsubmit="event.preventDefault(); alert('Subscribed!');">
                    <div class="input-group">
                        <input type="email" class="form-control form-control-sm border-0" placeholder="Enter your email" required>
                        <button class="btn btn-warning btn-sm fw-bold" type="submit">Subscribe</button>
                    </div>
                </form>
                <div>
                    <a href="#" class="text-white me-3 social-icon"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="text-white me-3 social-icon"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="text-white me-3 social-icon"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="text-white social-icon"><i class="fab fa-youtube"></i></a>
                </div>
            </div>
        </div>

        <hr class="border-secondary my-4">

        <div class="row align-items-center">
            <div class="col-md-6 text-center text-md-start">
                <p class="small text-secondary mb-0">
                    &copy; @DateTime.Now.Year <strong>@appName</strong>. All Rights Reserved.
                </p>
            </div>
            <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                <i class="fab fa-cc-visa text-secondary fa-2x me-2"></i>
                <i class="fab fa-cc-mastercard text-secondary fa-2x me-2"></i>
                <i class="fab fa-cc-amex text-secondary fa-2x"></i>
            </div>
        </div>
    </div>

    <style>
        .footer-link {
            transition: color 0.3s ease;
        }

            .footer-link:hover {
                color: #ffc107 !important; /* Bootstrap Warning Color */
                padding-left: 5px;
            }

        .social-icon {
            transition: transform 0.2s;
            display: inline-block;
        }

            .social-icon:hover {
                transform: translateY(-3px);
                color: #ffc107 !important;
            }
    </style>
</footer>