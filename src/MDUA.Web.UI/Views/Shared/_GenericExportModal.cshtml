@model Dictionary<string, string>
@* Key = DB Column Name, Value = Display Name *@

<div class="modal fade" id="exportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title"><i class="fas fa-file-export me-2 text-primary"></i>Export Data</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="exportForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Format</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="format" id="fmt_excel" value="excel" checked>
                            <label class="btn btn-outline-success" for="fmt_excel"><i class="fas fa-file-excel me-1"></i> Excel</label>

                            <input type="radio" class="btn-check" name="format" id="fmt_pdf" value="pdf">
                            <label class="btn btn-outline-danger" for="fmt_pdf"><i class="fas fa-file-pdf me-1"></i> PDF</label>

                            <input type="radio" class="btn-check" name="format" id="fmt_csv" value="csv">
                            <label class="btn btn-outline-secondary" for="fmt_csv"><i class="fas fa-file-csv me-1"></i> CSV</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Data Range</label>
                        <select class="form-select" id="exportScope" name="scope">
                            <option value="filtered">Current Filtered Results</option>
                            <option value="selected">Selected Rows Only (<span id="selectedCountDisplay">0</span>)</option>
                            <option value="all">All Data (Entire Database)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Include Columns</label>
                        <div class="row g-2 border rounded p-2 m-0 bg-light" style="max-height: 200px; overflow-y: auto;">
                            <div class="col-12 border-bottom pb-2 mb-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="selectAllCols" checked onchange="$('.col-check').prop('checked', this.checked)">
                                    <label class="form-check-label fw-bold" for="selectAllCols">Select All</label>
                                </div>
                            </div>
                            @foreach (var col in Model)
                            {
                                <div class="col-6">
                                    <div class="form-check">
                                        <input class="form-check-input col-check" type="checkbox" name="columns" value="@col.Key" id="col_@col.Key" checked>
                                        <label class="form-check-label small" for="col_@col.Key">@col.Value</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-white border" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitExport()">Download</button>
            </div>
        </div>
    </div>
</div>