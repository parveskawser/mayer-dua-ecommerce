@{
    ViewData["Title"] = "Courier Credentials";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0 fw-bold">Courier Credential Management</h3>
            <div class="text-muted small mt-1">Manage API integrations. Credentials are stored securely.</div>
        </div>
        <button class="btn btn-outline-secondary btn-sm" id="btnRefresh">
            <i class="fa fa-refresh"></i> Refresh
        </button>
    </div>

    <div id="ccAlert" class="alert alert-danger d-none"></div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:200px;">Courier</th>
                            <th>API Endpoint</th>
                            <th style="width:100px;" class="text-center">Status</th>
                            <th style="width:100px;" class="text-center">API Key</th>
                            <th style="width:100px;" class="text-center">Secret</th>
                            <th style="width:220px;" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="ccBody">
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Loading...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ccModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ccModalTitle">Update Credentials</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="ccModalError" class="alert alert-danger d-none"></div>
                <input type="hidden" id="ccCarrierId" />

                <div class="mb-2">
                    <label class="form-label">Courier</label>
                    <input type="text" class="form-control" id="ccCarrierName" readonly />
                </div>
                <div class="mb-2">
                    <label class="form-label">API Endpoint</label>
                    <input type="text" class="form-control" id="ccApiEndpoint" readonly />
                </div>
                <div class="mb-2">
                    <label class="form-label">API Key / Client ID</label>
                    <input type="text" class="form-control" id="ccApiKey" placeholder="Paste Key (optional if unchanged)" autocomplete="off" />
                </div>
                <div class="mb-2">
                    <label class="form-label">API Secret</label>
                    <input type="password" class="form-control" id="ccApiSecret" placeholder="Paste Secret (optional if unchanged)" autocomplete="new-password" />
                </div>

                <div id="ccPathaoFields" class="border rounded p-2 mb-2 bg-light d-none">
                    <div class="fw-semibold small text-muted mb-2"><i class="fa fa-info-circle"></i> Pathao Required Fields</div>
                    <div class="mb-2">
                        <label class="form-label small">Username / Email</label>
                        <input type="text" class="form-control form-control-sm" id="ccApiUsername" autocomplete="off" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Password</label>
                        <input type="password" class="form-control form-control-sm" id="ccApiPassword" autocomplete="new-password" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Store ID</label>
                        <input type="number" class="form-control form-control-sm" id="ccStoreId" />
                    </div>
                </div>

                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="ccIsActive">
                    <label class="form-check-label" for="ccIsActive">Active</label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" id="ccSaveBtn">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<script>
    window.ccEndpoints = {
        loadUrl: '@Url.Action("GetCourierCredentialSettings", "Shipment")',
        saveUrl: '@Url.Action("SaveCourierCredential", "Shipment")',
        toggleUrl: '@Url.Action("ToggleCourierActive", "Shipment")',
        testUrl: '@Url.Action("TestCourierConnection", "Shipment")'
    };
</script>

<script src="@Url.Content("~/js/courier-credentials.js")"></script>